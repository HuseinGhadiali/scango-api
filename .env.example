# Copy this file to .env and fill in real values. .env is git-ignored: never commit secrets.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Shared secret for signing payment webhooks (must match the sender).
PAYMENT_WEBHOOK_SECRET=change-me

# PostgreSQL password. Docker Compose uses it for both the db and web services.
DB_PASSWORD=change-me

# To run Django outside Docker against PostgreSQL, also set these. With DB_NAME unset the
# app uses SQLite.
# DB_NAME=scango
# DB_USER=scango
# DB_HOST=localhost
# DB_PORT=5432
